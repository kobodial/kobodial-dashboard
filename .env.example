# Base URL of a running kobodial-gateway, with no trailing slash.
#
#   local gateway:  http://localhost:3000
#   tunnelled:      https://something.trycloudflare.com
#   deployed:       https://gateway.your-host.example
#
# Named NEXT_PUBLIC_ because it identifies a public service rather than a
# secret — there is nothing sensitive in it, and no credential is ever
# sent to the gateway. Note that pages fetch it server-side (see
# lib/gateway.ts): rendering on the server keeps the browser from making
# cross-origin requests the gateway has no CORS headers to allow.
NEXT_PUBLIC_GATEWAY_API_URL=http://localhost:3000
